# BINANCE-AI-TRADER Environment Configuration
# Copy to .env and fill in values

# ============================================
# BINANCE API CREDENTIALS
# ============================================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_SECRET_KEY=your_testnet_secret_key_here

# ============================================
# TRADING MODE
# paper | live | safe | analysis
# ============================================
TRADING_MODE=paper

# ============================================
# NEWS / SENTIMENT (optional)
# ============================================
CRYPTOPANIC_API_KEY=your_cryptopanic_key_here
NEWSAPI_KEY=your_newsapi_key_here

# ============================================
# APP SETTINGS
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change_this_to_random_string_in_production
DEBUG=false

# ============================================
# NOTIFICATION (optional)
# ============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
