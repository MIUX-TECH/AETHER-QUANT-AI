{
  "app": {
    "name": "AETHER-QUANT-AI",
    "version": "4.0.0",
    "mode": "live",
    "api_port": 8000,
    "ui_port": 5173,
    "log_level": "INFO",
    "timezone": "UTC"
  },
  "binance": {
    "testnet": false,
    "base_url": "https://api.binance.com",
    "futures_base_url": "https://fapi.binance.com",
    "recv_window": 60000,
    "max_retries": 3,
    "retry_delay": 2
  },
  "scanner": {
    "default_symbols": ["BTCUSDT", "ETHUSDT", "SOLUSDT", "BNBUSDT", "XRPUSDT", "PEPEUSDT", "DOGEUSDT", "SHIBUSDT", "NEARUSDT", "AVAXUSDT", "TRXUSDT"],
    "scan_interval_seconds": 60,
    "timeframes": ["5m", "15m", "1h", "4h", "1d"],
    "lookback_candles": 200
  },
  "scheduler": {
    "scan_interval": 60,
    "rebalance_interval": 3600,
    "report_interval": 86400,
    "news_refresh_interval": 300,
    "learning_update_interval": 1800,
    "health_check_interval": 30
  },
  "storage": {
    "history_rotation_days": 90,
    "log_rotation_days": 30,
    "backup_enabled": true,
    "backup_interval": 3600,
    "max_backup_files": 24
  }
}
