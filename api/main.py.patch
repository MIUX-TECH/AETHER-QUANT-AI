import os, glob
@app.post("/api/admin/clean")
def admin_clean(verified: bool = Depends(verify_master_token)):
    res = []
    for d in ["history", "memory", "reports", "state"]:
        files = glob.glob(f"{d}/*.json")
        for f in files:
            os.remove(f)
            res.append(f)
    return {"cleaned": res}
